  {
    "id": "love.wed.bride_price",
    "domain": "love",
    "seed": "彩礼",
    "type": "choice",
    "age": [
      24,
      34
    ],
    "when": {
      "relationship": "dating",
      "flags": [
        "met_parents"
      ],
      "not_flags": [
        "wed_agreed"
      ]
    },
    "chance": 0.5,
    "cooldown": 2,
    "text": [
      {
        "t": "两家人第一次坐下来谈彩礼和嫁妆，母亲在桌子底下踢了你一脚。"
      },
      {
        "t": "对方家里提了一个数字，说\"这边都是这个规矩\"。"
      }
    ],
    "options": [
      {
        "label": "照对方说的办",
        "hint": "家里要拿出一大笔钱",
        "effects": {
          "money": "-max(30000, 0.4*income)",
          "mood": -2,
          "flags_add": [
            "wed_agreed"
          ]
        }
      },
      {
        "label": "两家商量",
        "hint": "各退一步",
        "p": 0.6,
        "success": {
          "money": "-max(15000, 0.2*income)",
          "flags_add": [
            "wed_agreed"
          ],
          "text": "两家各退了一步，数字定下来了。"
        },
        "fail": {
          "mood": -6,
          "text": "谈了三轮，谁也没让步。"
        },
        "auto": 2
      },
      {
        "label": "坚持不让步",
        "hint": "可能就此谈崩",
        "p": 0.5,
        "success": {
          "mood": -2,
          "flags_add": [
            "wed_agreed"
          ],
          "text": "僵了一个月，对方家里最后让了步。"
        },
        "fail": {
          "relationship": "single",
          "mood": -15,
          "flags_remove": [
            "met_parents",
            "cohabiting",
            "wants_home"
          ],
          "text": "谁也没让步，这婚没结成。"
        },
        "auto": 0.5
      }
    ]
