        "t": "部门里有证的人工资高一截。CPA 六科，你算了算要考三到五年。"
      },
      {
        "t": "领导说\"有空可以考个证\"，你听出来这不是建议。"
      }
    ],
    "options": [
      {
        "label": "报名",
        "hint": "每个周末都要搭进去",
        "effects": {
          "flags_add": [
            "cert_study"
          ],
          "money": "-0.3*living",
          "mood": -1
        }
      },
      {
        "label": "不报",
        "hint": "周末留给自己",
        "effects": {}
      }
    ]
  },
  {
    "id": "whitecollar.growth.cert_pass",
    "path": "whitecollar",
