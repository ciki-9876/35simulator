[
  {
    "id": "whitecollar.sales.client_dinner",
    "path": "whitecollar",
    "seed": "客户饭局",
    "type": "choice",
    "age": [
      22,
      34
    ],
    "when": {
      "path": "whitecollar",
      "role": "sales",
      "flags": [
        "wc_badge"
      ]
    },
    "chance": 0.3,
    "cooldown": 1,
    "text": [
      {
        "t": "饭局上客户举起杯子：\"这杯不喝，就是看不起我。\""
      },
      {
        "t": "客户的酒量是出了名的，领导提前跟你说\"今晚靠你了\"。"
      }
    ],
    "options": [
      {
        "label": "喝",
        "hint": "单子可能成，胃不一定扛得住",
        "auto": 1.5,
        "effects": {
          "health": -3,
          "social": 3,
          "mood": -1
        }
      },
      {
        "label": "以茶代酒",
        "hint": "客户可能不高兴",
        "p": 0.5,
        "success": {
          "mood": 2,
          "text": "客户笑着说\"那你多吃菜\"，单子照签。"
        },
        "fail": {
          "social": -2,
          "mood": -2,
          "text": "那单最后给了别家。"
        }
      }
    ]
  },
  {
    "id": "whitecollar.sales.quota",
    "path": "whitecollar",
    "seed": "业绩考核",
    "type": "chain",
    "age": [
      22,
      34
    ],
    "when": {
      "path": "whitecollar",
      "role": "sales",
      "flags": [
        "wc_badge"
      ]
    },
    "chance": 0.25,
    "cooldown": 1,
    "text": [
      {
        "t": "季度业绩没完成，奖金打了五折。"
      },
      {
        "t": "业绩排名表贴在墙上，你的名字在倒数第二行。"
      }
    ],
    "effects": {
      "money": "-0.06*income",
      "mood": -4
    }
  },
  {
    "id": "whitecollar.growth.raise_talk",
    "path": "whitecollar",
    "seed": "加薪谈判",
    "type": "choice",
    "age": [
      23,
      34
    ],
    "when": {
      "path": "whitecollar",
      "flags": [
        "wc_badge"
      ]
    },
    "chance": 0.35,
    "cooldown": 1,
    "text": [
      {
        "t": "年度调薪的邮件发下来了，你的数字比你想的少。",
        "when": {
          "season": [
            "year_end",
            "spring"
          ]
        }
      },
      {
        "t": "同期进来的同事悄悄说他涨了 15%，你没涨。"
      }
    ],
    "options": [
      {
        "label": "主动去谈",
        "hint": "准备好数据，也准备好被拒",
        "p": "0.3 + ability/250",
        "success": {
          "income_mult": 1.08,
          "mood": 3,
          "text": "领导看了你列的三页材料，说\"我去申请\"。"
        },
        "fail": {
          "mood": -3,
          "text": "领导说今年预算紧，明年一定。"
        }
      },
      {
        "label": "等通知",
        "hint": "会有的，大概",
        "auto": 1.5,
        "effects": {
          "income_mult": 1.02
        }
      }
    ]
  },
  {
    "id": "whitecollar.growth.promotion",
    "path": "whitecollar",
    "seed": "升主管",
    "type": "milestone",
    "age": [
      24,
      34
    ],
    "when": {
      "path": "whitecollar",
      "level": "<4",
      "flags": [
        "wc_badge"
      ]
    },
    "chance": "max(0.02, 0.08 + (ability - 50)/400)",
    "cooldown": 2,
    "text": [
      {
        "t": "名片上多了\"资深\"两个字，工资多了 800。",
        "when": {
          "level": "==1"
        }
      },
      {
        "t": "名片上多了\"主管\"两个字，工资多了 2000，手下多了三个人。",
        "when": {
          "level": "==2"
        }
      },
      {
        "t": "你升了经理，第一次参加管理层的会，发现大家也在吵同样的事。",
        "when": {
          "level": "==3"
        }
      }
    ],
    "effects": {
      "level": 1,
      "income_mult": 1.12,
      "mood": 5
    }
  },
  {
