  {
    "id": "whitecollar.growth.politics",
    "path": "whitecollar",
    "seed": "站队",
    "type": "choice",
    "age": [
      26,
      34
    ],
    "when": {
      "path": "whitecollar",
      "level": ">=3",
      "flags": [
        "wc_badge"
      ]
    },
    "chance": 0.25,
    "cooldown": 2,
    "text": [
      {
        "t": "两个副总不和，你的直属领导关上门问你：\"你怎么看？\""
      },
      {
        "t": "公司里分成了两派，午饭都分开吃，你端着餐盘不知道往哪边走。"
      }
    ],
    "options": [
      {
        "label": "表态",
        "hint": "赢了往上走，输了就难了",
        "p": 0.5,
        "success": {
          "income_mult": 1.1,
          "mood": 3,
          "text": "你站的那边赢了，年底你的名字在升职名单上。"
        },
        "fail": {
          "mood": -6,
          "flags_add": [
            "low_perf"
          ],
          "text": "你站的那位副总走了，你的项目被一个个拿走。"
        }
      },
      {
        "label": "装傻",
        "hint": "谁也不得罪，谁也不帮你",
        "auto": 1.5,
        "effects": {
          "mood": -1
        }
      }
    ]
  },
  {
