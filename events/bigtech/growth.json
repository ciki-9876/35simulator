  {
    "id": "bigtech.growth.perf_review",
    "path": "bigtech",
    "seed": "绩效季",
    "type": "choice",
    "age": [
      23,
      35
    ],
    "when": {
      "path": "bigtech",
      "sub": "fulltime"
    },
    "chance": 0.1,
    "cooldown": 2,
    "text": [
      {
        "t": "老板约你一对一，暗示今年组里要有人\"背一个\"低绩效。"
      },
      {
        "t": "绩效季到了，老板说\"今年名额紧张，你理解一下\"。"
      }
    ],
    "options": [
      {
        "label": "争取",
        "hint": "成功率{p} · 和老板关系变僵",
        "p": "0.3 + ability/200",
        "success": {
          "mood": 3,
          "text": "你拿出了全年的数据，低绩效最后没落到你头上。"
        },
        "fail": {
          "mood": -10,
          "flags_add": [
            "low_perf"
          ],
          "text": "你争了，结果没变，还多了一个\"不好管\"的评价。",
          "modifier": {
            "layoff": 3,
            "months": 12
          }
        }
      },
      {
        "label": "接受",
        "hint": "今年没有年终奖",
        "effects": {
          "mood": -8,
          "flags_add": [
            "low_perf"
          ],
          "modifier": {
            "layoff": 3,
            "months": 12
          }
        }
      },
      {
        "label": "提离职",
        "hint": "带着这份委屈走",
        "effects": {
          "path": "unemployed",
          "exit_reason": "quit",
          "mood": -3
        }
      }
    ]
  },
