[
  {
    "id": "bigtech.cross.last_day",
    "path": "bigtech",
    "seed": "最后一天",
    "type": "milestone",
    "age": [
      23,
      35
    ],
    "trigger": "path_change",
    "transition": {
      "from": "bigtech",
      "to": "unemployed"
    },
    "text": [
      {
        "t": "交还工牌和电脑，你回头刷了一下门禁，门没开。"
      },
      {
        "t": "最后一天，你把工位上的绿萝送给了邻座。"
      }
    ],
    "effects": {
      "mood": -5
    }
  },
  {
    "id": "bigtech.cross.severance",
    "path": "bigtech",
    "seed": "赔偿到账",
    "type": "chain",
    "age": [
      23,
      35
    ],
    "when": {
      "path": "unemployed",
      "exit_reason": "laid_off",
      "history_any": [
        "bigtech"
      ],
      "gap_months": "<=1"
    },
    "chance": 1,
    "once": true,
    "text": [
      {
        "t": "赔偿到账，{severance}，像放了一个很长的假。"
      },
      {
        "t": "赔偿到账那天，你睡到中午，醒来不知道该干什么。"
      }
    ],
    "effects": {
      "mood": 2
    }
  },
  {
    "id": "bigtech.cross.fired_no_pay",
    "path": "bigtech",
    "seed": "违纪没有赔偿",
    "type": "chain",
    "age": [
      23,
      35
    ],
    "trigger": "path_change",
    "transition": {
      "from": "bigtech",
      "to": "unemployed"
    },
    "when": {
      "exit_reason": "fired"
    },
    "text": [
      {
        "t": "同样是离开，因为违纪被解除的人拿不到赔偿。"
      },
      {
        "t": "离职证明上写着\"严重违纪\"，下一份工作的背调会看到。"
      }
    ],
    "effects": {
      "mood": -8
    }
  },
  {
    "id": "bigtech.cross.noncompete",
    "path": "bigtech",
    "seed": "竞业限制",
    "type": "chain",
    "age": [
      26,
      35
    ],
    "when": {
      "path": "unemployed",
      "exit_reason": "laid_off",
      "history_any": [
        "bigtech"
      ],
      "level": ">=3"
    },
    "chance": 0.2,
    "once": true,
    "text": [
      {
        "t": "公司通知启动竞业限制，你有一段时间不能去同行。"
      },
      {
        "t": "竞业期间每月有一笔补偿，同类大厂的岗位你都不能投。"
      }
    ],
    "effects": {
      "modifier": {
        "ban_same_type": 1,
        "months": 12
      }
    }
  },
  {
    "id": "bigtech.cross.quit",
    "path": "bigtech",
    "seed": "裸辞",
    "type": "choice",
    "age": [
      23,
      35
    ],
    "when": {
      "path": "bigtech",
      "stat": {
        "mood": "<30"
      }
    },
    "chance": 0.5,
    "cooldown": 1,
    "text": [
      {
        "t": "你已经连续三个月失眠了。"
      },
      {
        "t": "周日晚上，你打开电脑想写周报，手停在键盘上不动。"
      }
    ],
    "help": [
      "hotline_12356"
    ],
    "options": [
      {
        "label": "裸辞",
        "hint": "先停下来 · 没有失业金",
        "effects": {
          "path": "unemployed",
          "exit_reason": "quit",
          "mood": 8
        }
      },
      {
        "label": "请病假",
        "hint": "休息一个月再说",
        "effects": {
          "mood": 5,
          "health": 3
        }
      },
      {
        "label": "再熬熬",
        "hint": "年终奖还没发",
        "effects": {
          "mood": -3
        }
      }
    ]
  },
  {
