[
  {
    "id": "unemployed.gap.decide",
    "path": "unemployed",
    "seed": "决定 gap",
    "type": "choice",
    "age": [
      22,
      24
    ],
    "when": {
      "path": "unemployed",
      "flags": [
        "fresh_grad"
      ],
      "family_tier": ">=3"
    },
    "chance": 0.3,
    "once": true,
    "text": [
      {
        "t": "毕业了，你想先停一停，再决定要做什么。"
      },
      {
        "t": "大家都在找工作，你想给自己放一年假。"
      }
    ],
    "options": [
      {
        "label": "去旅行",
        "hint": "看看外面",
        "effects": {
          "sub": "gap",
          "flags_add": [
            "gap_travel"
          ],
          "mood": 8
        }
      },
      {
        "label": "学技能",
        "hint": "给简历加点东西",
        "effects": {
          "sub": "gap",
          "flags_add": [
            "gap_learn"
          ],
          "mood": 3
        }
      },
      {
        "label": "在家调整",
        "hint": "什么都不做",
        "effects": {
          "sub": "gap",
          "mood": 5
        }
      },
      {
        "label": "还是先找工作",
        "hint": "空窗越短越好"
      }
    ]
  },
  {
