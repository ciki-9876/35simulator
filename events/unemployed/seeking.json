  {
    "id": "unemployed.seek.unpaid_trial",
    "path": "unemployed",
    "seed": "无薪试岗",
    "type": "choice",
    "age": [
      22,
      35
    ],
    "when": {
      "path": "unemployed"
    },
    "chance": 0.1,
    "cooldown": 2,
    "text": [
      {
        "t": "一家公司要你先免费\"试岗\"三天，看看合不合适。"
      },
      {
        "t": "HR 说：\"先来干一周，没问题就签合同。\""
      }
    ],
    "options": [
      {
        "label": "去",
        "hint": "可能是机会 · 可能白干",
        "p": 0.4,
        "success": {
          "path": "whitecollar",
          "text": "试岗结束，你签了合同。"
        },
        "fail": {
          "mood": -5,
          "text": "第三天下午，对方说\"不太合适\"，一分钱没给。"
        }
      },
      {
        "label": "不去",
        "hint": "试用期本来就该有工资"
      }
    ]
  },
  {
