[
  {
    "id": "service.entry.start",
    "path": "service",
    "seed": "注册",
    "type": "milestone",
    "age": [
      22,
      35
    ],
    "when": {
      "path": "service"
    },
    "chance": 1,
    "once": true,
    "text": [
      {
        "t": "你领到了头盔和保温箱，箱子上还有上一个人贴的贴纸。",
        "when": {
          "sub": "rider"
        }
      },
      {
        "t": "网点主管递给你一把巴枪，说\"扫错一件扣五块\"。",
        "when": {
          "sub": "courier"
        }
      },
      {
        "t": "第一天，{company}的店长给了你一件工服，袖口有点短。",
        "when": {
          "sub": "store"
        }
      },
      {
        "t": "你办下了网约车驾驶员证，在后座放了一盒纸巾。",
        "when": {
          "sub": "driver"
        }
      }
    ],
    "effects": {
      "mood": 1,
      "flags_add": [
        "sv_badge"
      ]
    }
  },
  {
    "id": "service.rider.first_order",
    "path": "service",
    "seed": "第一单",
    "type": "daily",
    "age": [
      22,
      35
    ],
    "when": {
      "path": "service",
      "sub": "rider",
      "tenure": "<1",
      "flags": [
        "sv_badge"
      ]
    },
    "weight": 3,
    "once": true,
    "text": [
      {
        "t": "第一单就超时了，顾客说\"没事\"，你还是道了好几次歉。"
      },
      {
        "t": "导航把你带进一个没有侧门的小区，你绕了三圈才找到楼。"
      }
    ],
    "effects": {
      "mood": -1,
      "ability": 1
    }
  },
  {
